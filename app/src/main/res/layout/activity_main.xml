<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <!-- GRADIENT HEADER -->
        <LinearLayout
            android:id="@+id/headerSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingBottom="60dp"
            android:fitsSystemWindows="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Top row: App name + settings + logout -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="8dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️"
                        android:textSize="22sp"
                        android:layout_marginEnd="8dp"/>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sakhi Shield"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Women Safety Application"
                            android:textSize="10sp"
                            android:textColor="@color/colorPrimaryLight"
                            android:letterSpacing="0.05"/>

                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/settingsBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:text="⚙"
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:backgroundTint="#33FFFFFF"
                    android:padding="0dp"
                    style="@style/Widget.AppCompat.Button.Borderless"/>

                <Button
                    android:id="@+id/logoutBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Logout"
                    android:textSize="11sp"
                    android:textColor="@color/colorPrimaryLight"
                    android:backgroundTint="@android:color/transparent"
                    style="@style/Widget.AppCompat.Button.Borderless"/>

            </LinearLayout>

            <!-- Profile Info Row -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/profileInitial"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="P"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorPrimary"
                    android:gravity="center"
                    android:background="@drawable/circle_white_bg"
                    android:layout_marginEnd="14dp"/>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/profileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Username"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"/>

                    <TextView
                        android:id="@+id/profileEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="email@example.com"
                        android:textSize="12sp"
                        android:textColor="@color/colorPrimaryLight"
                        android:layout_marginTop="2dp"/>

                    <TextView
                        android:id="@+id/profilePhone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+91 XXXXXXXXXX"
                        android:textSize="12sp"
                        android:textColor="@color/colorPrimaryLight"
                        android:layout_marginTop="2dp"/>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- PANIC BUTTON -->
        <!-- FIX #5: Changed to wrap_content so it doesn't clip on small screens -->
        <FrameLayout
            android:id="@+id/panicContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@+id/headerSection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <View
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:background="@drawable/panic_ring_outer"
                android:layout_gravity="center"/>

            <View
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:background="@drawable/panic_ring_middle"
                android:layout_gravity="center"/>

            <Button
                android:id="@+id/panicButton"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:background="@drawable/panic_button_bg"
                android:text="PANIC"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:elevation="12dp"
                android:layout_gravity="center"/>

        </FrameLayout>

        <!-- Stop Recording Button -->
        <Button
            android:id="@+id/stopRecordingBtn"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="⏹  Stop Recording"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:backgroundTint="#FF5722"
            android:layout_marginStart="48dp"
            android:layout_marginEnd="48dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:elevation="4dp"
            app:layout_constraintTop_toBottomOf="@+id/panicContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Status Text -->
        <!-- FIX #6: Added textAlignment="center" so text centres properly -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Press PANIC in emergency"
            android:textSize="12sp"
            android:textColor="@color/colorTextSecondary"
            android:textAlignment="center"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@+id/stopRecordingBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- ACTION BUTTONS CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/actionsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/white"
            app:layout_constraintTop_toBottomOf="@+id/statusText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- Manage Contacts Row -->
                <LinearLayout
                    android:id="@+id/contactRow"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="8dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:text="👥"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:background="@drawable/icon_bg_pink"
                        android:layout_marginEnd="14dp"/>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manage Contacts"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add or edit emergency contacts"
                            android:textSize="11sp"
                            android:textColor="@color/colorTextSecondary"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="@color/colorPrimary"
                        android:gravity="center"/>

                </LinearLayout>

                <View android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorDivider"
                    android:layout_marginStart="76dp"/>

                <!-- Alert History Row -->
                <LinearLayout
                    android:id="@+id/logRow"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="8dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:text="📋"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:background="@drawable/icon_bg_pink"
                        android:layout_marginEnd="14dp"/>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Alert History"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View all past emergency alerts"
                            android:textSize="11sp"
                            android:textColor="@color/colorTextSecondary"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="@color/colorPrimary"
                        android:gravity="center"/>

                </LinearLayout>

                <View android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorDivider"
                    android:layout_marginStart="76dp"/>

                <!-- Save Home Location Row -->
                <LinearLayout
                    android:id="@+id/homeRow"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="8dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:text="🏠"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:background="@drawable/icon_bg_pink"
                        android:layout_marginEnd="14dp"/>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Save Home Location"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Set your safe home address"
                            android:textSize="11sp"
                            android:textColor="@color/colorTextSecondary"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="@color/colorPrimary"
                        android:gravity="center"/>

                </LinearLayout>

                <View android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorDivider"
                    android:layout_marginStart="76dp"/>

                <!-- Saved Recordings Row -->
                <LinearLayout
                    android:id="@+id/savedRecordingsRow"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center_vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="8dp"
                    android:background="?attr/selectableItemBackground">

                    <TextView
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:text="🎙"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:background="@drawable/icon_bg_pink"
                        android:layout_marginEnd="14dp"/>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Saved Recordings"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/colorTextPrimary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View emergency audio recordings"
                            android:textSize="11sp"
                            android:textColor="@color/colorTextSecondary"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:text="›"
                        android:textSize="22sp"
                        android:textColor="@color/colorPrimary"
                        android:gravity="center"/>

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Bottom note -->
        <!-- FIX #6: Added textAlignment="center" -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sakhi Shield v1.0 — Stay Safe 🛡️"
            android:textSize="11sp"
            android:textColor="#CCCCCC"
            android:textAlignment="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@+id/actionsCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>